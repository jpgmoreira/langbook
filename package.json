{
  "name": "Xlangbook",
  "productName": "XLangbook",
  "version": "0.0.1",
  "description": "An application for studying languages",
  "main": "./out/main/main.js",
  "author": {
    "name": "The Langbook Team",
    "email": "jpgmoreira19@gmail.com"
  },
  "homepage": "https://github.com/jpgmoreira/langbook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpgmoreira/langbook.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "start:perf": "cross-env ENABLE_PERFORMANCE_LOGS=true electron-vite dev",
    "dev:perf": "cross-env ENABLE_PERFORMANCE_LOGS=true electron-vite dev",
    "test": "vitest",
    "test:debug": "vitest --test-timeout=0 --no-file-parallelism",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "madge": "madge --circular --extensions ts src/main src/common src/preload"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "cheerio": "^1.1.2",
    "floating-vue": "^5.2.2",
    "pinia": "^3.0.3",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.4.0",
    "happy-dom": "^20.0.10",
    "madge": "^8.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^4.0.6",
    "vue": "^3.5.21",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  }
}
